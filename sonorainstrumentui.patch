-+    radial-gradient(58% 46% at 50% 44%, rgb(var(--bg-rgb) / .58), transparent 74%),
-+    linear-gradient(to bottom, rgb(var(--bg-rgb) / .45), transparent 24%, transparent 74%, rgb(var(--bg-rgb) / .34));
