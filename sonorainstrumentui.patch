-+/* intro.css — the welcome sequence.
-+ *
-+ * Loaded second, right after the tokens, so the intro is styled by the time
-+ * the first frame is painted. Everything animated here is transform, opacity
-+ * or a stroke offset, all of which stay off the layout thread.
-+ */
-+
-+.intro {
-+  position: fixed;
-+  inset: 0;
-+  z-index: 900;
-+  display: grid;
-+  place-items: center;
-+  padding: 24px;
-+  /* Translucent, so the 3D backdrop is already playing behind the welcome —
-+     the app arrives into a room that was there before it. */
-+  background:
-+    radial-gradient(120% 90% at 50% 8%, rgb(var(--accent-rgb) / .20), transparent 62%),
-+    radial-gradient(90% 70% at 50% 110%, rgb(var(--accent-rgb) / .10), transparent 60%),
-+    rgb(var(--bg-rgb) / .80);
-+  will-change: opacity, transform, filter;
-+  /* If the modules never load, the intro is not allowed to hold the app
-+     hostage: it leaves on its own after eight seconds. */
-+  animation: intro-failsafe 600ms linear 8s forwards;
-+}
-+
-+@keyframes intro-failsafe { to { opacity: 0; visibility: hidden; pointer-events: none; } }
-+
-+.intro-stage {
-+  display: grid;
-+  justify-items: center;
-+  gap: 2px;
-+  text-align: center;
-+  will-change: transform, opacity;
-+}
-+
-+/* ------------------------------------------------------------------ mark */
-+
-+.intro-logo {
-+  width: 132px;
-+  height: 132px;
-+  margin-bottom: 22px;
