-+  vec3 col = vec3(0.0);
-+  float acc = 0.0;
-+
-+  for (int i = 0; i < 3; i++) {
-+    float fi = float(i);
-+    vec2 c = vec2(
-+      sin(t * (0.62 + fi * 0.21) + fi * 2.3) * 0.46,
-+      cos(t * (0.47 + fi * 0.29) + fi * 1.6) * 0.32);
