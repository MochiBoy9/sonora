-+/* visualizer.css — the spectrum, wherever it appears.
-+ *
-+ * Three places: inside the now-playing artwork, as a hairline ribbon along the
-+ * top of the player bar, and full-bleed on the immersive stage.
-+ */
-+
-+/* ------------------------------------------------------------------ pane */
-+
-+.np-viz {
-+  position: absolute;
-+  left: 8px; bottom: 8px;
-+  /* An absolutely positioned <canvas> is a replaced element: with width:auto it
-+     takes its intrinsic (attribute) size and ignores `right`, so be explicit. */
-+  width: calc(100% - 16px);
-+  height: 38%;
-+  pointer-events: none;
-+  border-radius: 0 0 calc(var(--r-lg) - 5px) calc(var(--r-lg) - 5px);
-+  /* A soft scrim so the bars read against pale artwork too. */
-+  background: linear-gradient(to top, rgb(0 0 0 / .42), transparent 80%);
-+  opacity: .92;
-+  transition: opacity var(--dur-3) var(--ease);
-+}
-+.np:not(.is-playing) .np-viz { opacity: .55; }
-+
-+/* ------------------------------------------------------------------ ribbon */
-+
-+/* The thin spectrum that rides the top edge of the transport bar. It is
-+   decoration, so it never takes a pointer event and never affects layout. */
-+.pb-viz {
-+  position: absolute;
-+  left: 0; right: 0;
-+  top: -22px;
-+  width: 100%;
-+  height: 24px;
-+  pointer-events: none;
-+  opacity: 0;
-+  transition: opacity var(--dur-3) var(--ease);
-+  mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
-+  -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
-+}
-+.playerbar.is-playing .pb-viz { opacity: .55; }
-+
-+/* ------------------------------------------------------------------ stage */
-+
-+.stage {
-+  position: fixed;
-+  inset: 0;
-+  z-index: 800;
-+  display: grid;
-+  grid-template-rows: auto minmax(0, 1fr) auto;
-+  overflow: hidden;
-+  background:
-+    radial-gradient(120% 80% at 50% 0%, rgb(var(--accent-rgb) / .16), transparent 60%),
-+    rgb(var(--bg-rgb) / .93);
-+  backdrop-filter: blur(32px) saturate(140%);
-+  -webkit-backdrop-filter: blur(32px) saturate(140%);
-+  will-change: opacity, transform;
-+}
-+
-+/* While the stage is up the 3D backdrop is moved inside it, so it plays behind
-+   the artwork rather than behind a sheet of frosted glass. */
-+.stage > .backdrop { z-index: 0; }
-+
-+.stage-viz {
-+  position: absolute;
-+  inset: 0;
-+  width: 100%;
-+  height: 100%;
-+  z-index: 1;
-+  pointer-events: none;
-+}
-+
-+.stage-veil {
-+  position: absolute;
-+  inset: 0;
-+  z-index: 1;
-+  pointer-events: none;
-+  /* Enough to keep the type readable over anything the visualiser draws, and
-+     no more: the bars live down here too. */
