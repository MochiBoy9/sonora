+    ctx.save();
+    ctx.translate(cx, cy);
+    ctx.rotate(rotation);
+
+    ctx.lineCap = 'round';
+    for (let i = 0; i < n; i++) {
+      let v = 0;
+      for (let j = Math.floor(i * step); j < Math.floor((i + 1) * step); j++) v = Math.max(v, a.bands[j]);
