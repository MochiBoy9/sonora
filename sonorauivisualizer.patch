+  float glow = pow(smoothstep(0.5, 0.0, r), 2.1);
+  // Near the camera and far away both fade out, so points arrive and leave.
+  float fade = smoothstep(0.0, 0.14, v_depth) * (1.0 - smoothstep(0.68, 1.0, v_depth));
