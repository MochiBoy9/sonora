+      const len = base * 0.18 + v * Math.min(w, h) * 0.28;
+      const t = i / n;
+      const colour = [
+        Math.round(accent[0] + (accent2[0] - accent[0]) * t),
+        Math.round(accent[1] + (accent2[1] - accent[1]) * t),
+        Math.round(accent[2] + (accent2[2] - accent[2]) * t),
