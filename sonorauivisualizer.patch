+    const ink = light ? 1 : 0;
+
+    if (reduceMotion.matches) {
+      const key = `${w}x${h}|${accent.join()}|${alpha}|${ink}`;
+      if (key === staticKey) return;                  // already on screen
+      staticKey = key;
+    } else staticKey = '';
