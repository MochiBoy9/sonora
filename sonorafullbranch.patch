+ * application are cut with `clip-path` chamfers and a shadow is clipped away
+ * with the corner it was drawn on. An outline is not. */
+:where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
