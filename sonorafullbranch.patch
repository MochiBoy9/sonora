+/* ------------------------------------------------------------------ A6
+
+   The skip link, and one rule for focus.
+
+   Off screen rather than hidden: `display: none` and `visibility: hidden` both
+   take an element out of the focus order, which would make a skip link that
+   cannot be reached — the exact failure it exists to fix. */
+.skip-link {
+  position: fixed;
+  top: 8px;
+  left: 8px;
+  z-index: 2000;
+  transform: translateY(-160%);
+  padding: 9px 14px;
+  border-radius: calc(var(--radius) * 0.6);
+  background: var(--accent);
+  color: var(--on-accent);
+  font-weight: 600;
+  font-size: calc(13px * var(--scale));
+  text-decoration: none;
+  box-shadow: var(--sh-2, 0 10px 30px rgb(0 0 0 / .4));
+  transition: transform var(--dur-2) var(--ease);
