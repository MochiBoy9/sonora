diff --git a/js/app.js b/js/app.js
index e108efe..8ee05f1 100644
--- a/js/app.js
+++ b/js/app.js
@@ -78,15 +78,26 @@ function swapView() {
      every page afterwards inherited it. Resetting here fixes it for every
