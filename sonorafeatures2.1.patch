+    toast(`Added ${report.added.toLocaleString()} tracks · merged ${names}${more}`, {
+      duration: 5200,
+      action: merged.length === 1
+        ? { label: 'Open', onSelect: () => (location.hash = '#/album/' + merged[0].key) }
+        : null,
+    });
